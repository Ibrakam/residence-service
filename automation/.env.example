# Copy this file outside the repository, fill it in, and chmod 600.
# Never commit the real worker API token or deployment credentials.

RUNNER_ID=avalon-mac-01
RUNNER_SERVER_BASE_URL=https://form.tencorp.uz/__residence-ticket-worker/
RUNNER_API_TOKEN_FILE=/Users/REPLACE_ME/Library/Application Support/AvalonTicketRunner/worker-api-token

RUNNER_REPO_ROOT=/Users/REPLACE_ME/Documents/ChatGPT/avalon residence
RUNNER_STATE_DIR=/Users/REPLACE_ME/Library/Application Support/AvalonTicketRunner
RUNNER_WORKTREE_ROOT=/Users/REPLACE_ME/Library/Application Support/AvalonTicketRunner/worktrees

CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_HOME=/Users/REPLACE_ME/.codex
RUNNER_CODEX_MODEL=gpt-5.6-sol
RUNNER_CODEX_TIMEOUT_MS=2700000

RUNNER_ALLOWED_PATHS=website
RUNNER_VERIFY_COMMANDS_JSON='[{"name":"website-install","cwd":"website","argv":["npm","ci","--ignore-scripts","--no-audit","--no-fund"],"timeoutMs":900000},{"name":"website-lint","cwd":"website","argv":["npm","run","lint"],"timeoutMs":600000},{"name":"website-build","cwd":"website","argv":["npm","run","build"],"timeoutMs":1200000}]'
RUNNER_VERIFICATION_ENV_ALLOWLIST=CI,NODE_ENV,NEXT_PUBLIC_SITE_URL,NEXT_PUBLIC_APP_BASE_PATH,NEXT_PUBLIC_ASSET_PREFIX,NEXT_PUBLIC_CATALOG_API_URL
NEXT_PUBLIC_SITE_URL=https://form.tencorp.uz
NEXT_PUBLIC_APP_BASE_PATH=
NEXT_PUBLIC_ASSET_PREFIX=/residence-assets
NEXT_PUBLIC_CATALOG_API_URL=/residence-api/catalog

# This must be an absolute, executable, trusted script outside each ticket worktree.
# The deployment implementation is maintained separately under automation/deploy/.
RUNNER_DEPLOY_SCRIPT=/Users/REPLACE_ME/Library/Application Support/AvalonTicketRunner/bin/deploy-residence-root-remote
RUNNER_DEPLOY_ARGS_JSON=[]
RUNNER_DEPLOY_ENV_ALLOWLIST=SSH_AUTH_SOCK
RUNNER_DEPLOY_TIMEOUT_MS=1200000
RUNNER_SMOKE_URLS=https://form.tencorp.uz/4u/apartments
RUNNER_SMOKE_TIMEOUT_MS=30000

RUNNER_POLL_INTERVAL_MS=5000
RUNNER_LEASE_SECONDS=180
RUNNER_HEARTBEAT_INTERVAL_MS=30000
RUNNER_MAX_HEARTBEAT_FAILURES=3
RUNNER_ATTACHMENT_ALLOWED_HOSTS=form.tencorp.uz
RUNNER_ATTACHMENT_MAX_COUNT=10
RUNNER_ATTACHMENT_MAX_BYTES=26214400
RUNNER_KEEP_SUCCESSFUL_WORKTREES=true
RUNNER_KEEP_FAILED_WORKTREES=true
RUNNER_DRY_RUN=true
RUNNER_LOG_LEVEL=info
