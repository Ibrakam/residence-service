# Replace the key fields with the contents of
# ~/.ssh/tencorp_market_map_deploy_ed25519.pub, then append this single line to
# /root/.ssh/authorized_keys. Keep `restrict` and the forced command unchanged.
restrict,command="/usr/local/sbin/tencorp-market-map-deploy-gate" ssh-ed25519 REPLACE_WITH_DEDICATED_MARKET_MAP_PUBLIC_KEY tencorp-market-map-deploy
