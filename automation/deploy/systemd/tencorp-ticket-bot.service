[Unit]
Description=TENCORP Telegram ticket intake and worker API
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=tencorp-ticket-bot
Group=tencorp-ticket-bot
WorkingDirectory=/opt/tencorp-ticket-bot/current
EnvironmentFile=/etc/tencorp-ticket-bot/bot.env
ExecStartPre=/usr/bin/test -x /opt/tencorp-ticket-bot/current/ticket-bot
ExecStartPre=/usr/bin/test -d /opt/tencorp-ticket-bot/current/migrations
ExecStart=/usr/bin/env TICKET_BOT_ADDR=127.0.0.1:4330 TICKET_ATTACHMENT_DIR=/var/lib/tencorp-ticket-bot/attachments MIGRATIONS_DIR=/opt/tencorp-ticket-bot/current/migrations TICKET_AUTO_MIGRATE=false /opt/tencorp-ticket-bot/current/ticket-bot
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

StateDirectory=tencorp-ticket-bot
StateDirectoryMode=0700
RuntimeDirectory=tencorp-ticket-bot
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/tencorp-ticket-bot
ReadOnlyPaths=/etc/tencorp-ticket-bot
InaccessiblePaths=/etc/residence-service /etc/residence-frontend /root

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
