# Copy to /etc/tencorp-auth-gateway/bot.env as root:root mode 0600. It is read
# by configure-tencorp-auth-bot.sh and, only when the optional bot webhook is
# enabled, by the gateway service. Rotate any token that has appeared in chat,
# logs, shell history, or source control before placing the replacement here.

TELEGRAM_AUTH_BOT_TOKEN=CHANGE_ME_ROTATED_BOT_API_TOKEN
TELEGRAM_AUTH_WEBHOOK_SECRET=GENERATE_ME
TELEGRAM_BOT_EXPECTED_ID=CHANGE_ME_NUMERIC_BOT_ID

# Optional. Bot API 10.0+ accepts a newly uploaded static JPG profile photo.
# Leave empty until a reviewed square TENCORP avatar has been installed.
TELEGRAM_BOT_PROFILE_PHOTO_FILE=
