# Copy to /etc/tencorp-auth-gateway/gateway.env as root:root mode 0600.
# Replace every CHANGE_ME value. Do not commit the real file.
#
# TELEGRAM_OIDC_CLIENT_SECRET is the OIDC secret displayed under BotFather's
# Login Widget settings. It is not the Telegram Bot API token. Optional Bot API
# webhook credentials live in the separately permissioned bot.env.

DATABASE_URL=postgres://tencorp_auth_gateway:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/residence_service?sslmode=disable
AUTH_PUBLIC_ORIGIN=https://form.tencorp.uz
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_CLIENT_ID=CHANGE_ME_BOTFATHER_OIDC_CLIENT_ID
TELEGRAM_OIDC_CLIENT_SECRET=CHANGE_ME_BOTFATHER_OIDC_CLIENT_SECRET

AUTH_GATEWAY_ADDR=127.0.0.1:4340
AUTH_SESSION_TTL=720h
AUTH_TRANSACTION_TTL=10m
AUTH_SHUTDOWN_TIMEOUT=15s
AUTH_OIDC_HTTP_TIMEOUT=10s
AUTH_AUTO_MIGRATE=false
MIGRATIONS_DIR=/opt/tencorp-auth-gateway/current/migrations

# The optional Bot API message webhook is disabled by default. Do not put its
# token here. Enabling it requires the reviewed systemd drop-in, which loads a
# separately permissioned bot.env and sets AUTH_BOT_WEBHOOK_ENABLED=true.
