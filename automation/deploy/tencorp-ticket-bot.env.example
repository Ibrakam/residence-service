# Copy to /etc/tencorp-ticket-bot/bot.env as root:root mode 0600.
# Replace every CHANGE_ME value. Do not commit the real file.

DATABASE_URL=postgres://tencorp_ticket_bot:CHANGE_ME@127.0.0.1:5432/residence_service?sslmode=disable
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
TELEGRAM_ALLOWED_USER_IDS=CHANGE_ME_USER_ID_1,CHANGE_ME_USER_ID_2
TICKET_WORKER_API_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TICKET_PUBLIC_WORKER_BASE_URL=https://form.tencorp.uz/__residence-ticket-worker/

TICKET_BOT_CONSUMER=tencorp-production-telegram
TICKET_LONG_POLL_TIMEOUT=25s
TICKET_MEDIA_GROUP_DELAY=2s
TICKET_WORKER_LEASE_TTL=3m
TICKET_SHUTDOWN_TIMEOUT=20s
TICKET_MAX_ATTACHMENT_BYTES=20971520
TICKET_ATTACHMENT_RETENTION=720h
TICKET_ATTACHMENT_DISK_WARN_BYTES=5368709120
