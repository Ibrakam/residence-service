[Unit]
Description=Block confirmed TenCorp vulnerability scanners
After=network-online.target nginx.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
Environment=LC_ALL=C.UTF-8
EnvironmentFile=/etc/residence-catalog-alerts/monitor.env
LoadCredential=telegram-token:/etc/residence-catalog-alerts/telegram-token
StateDirectory=tencorp-scanner-autoban
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/tencorp-lead-guard/scanner-autoban.py
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_KILL
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/tencorp-scanner-autoban /etc/ufw /etc/nginx/conf.d /var/log/nginx /run/ufw.lock
MemoryMax=128M
TimeoutStartSec=120s
