[Unit]
Description=TenCorp security event notifications
After=network-online.target

[Service]
Type=oneshot
Environment=LC_ALL=C.UTF-8
User=tencorp-security-monitor
Group=tencorp-security-monitor
SupplementaryGroups=adm systemd-journal
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/run/dbus/system_bus_socket /run/systemd/private
EnvironmentFile=/etc/residence-catalog-alerts/monitor.env
LoadCredential=telegram-token:/etc/residence-catalog-alerts/telegram-token
StateDirectory=tencorp-security-monitor
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/tencorp-lead-guard/security-monitor.py
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tencorp-security-monitor
MemoryMax=128M
TimeoutStartSec=35s
