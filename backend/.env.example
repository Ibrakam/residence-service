API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog?sslmode=disable
MIGRATIONS_DIR=./migrations
KAYAN_RAW_DATA_DIR=./data/raw/kayan
CATALOG_DATA_DIR=../website/data
AUTO_MIGRATE=false
IMPORT_ON_START=false
LEAD_WRITES_ENABLED=false
ALLOWED_ORIGIN=http://localhost:3000
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s
LEAD_DUPLICATE_WINDOW=1m
LEAD_MAX_IN_FLIGHT=8

# Telegram ticket intake. Keep both tokens in a server-side secret manager;
# never commit real values. The worker API listener must stay on loopback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TICKET_BOT_ADDR=127.0.0.1:8090
TICKET_BOT_CONSUMER=residence-ticket-bot
TICKET_WORKER_API_TOKEN=
TICKET_PUBLIC_WORKER_BASE_URL=https://form.tencorp.uz/__residence-ticket-worker/
TICKET_ATTACHMENT_DIR=./data/tickets/attachments
TICKET_AUTO_MIGRATE=false
TICKET_LONG_POLL_TIMEOUT=25s
TICKET_MEDIA_GROUP_DELAY=2s
TICKET_WORKER_LEASE_TTL=2m
TICKET_SHUTDOWN_TIMEOUT=15s
TICKET_MAX_ATTACHMENT_BYTES=20971520
TICKET_ATTACHMENT_RETENTION=720h
TICKET_ATTACHMENT_DISK_WARN_BYTES=5368709120
