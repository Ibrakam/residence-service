# DATABASE_URL must be injected into the installed root-owned runtime.env by
# the server secret-management process. The sync CLI refuses the development
# fallback when this value is absent. Never commit the real value.
# DATABASE_URL=postgres://...

LIVE_SYNC_CAPTURE_DIR=/var/lib/residence-live-sync/captures
LIVE_SYNC_CDP_KAYAN_URL=http://127.0.0.1:9222
LIVE_SYNC_CDP_MBC_URL=http://127.0.0.1:9222
LIVE_SYNC_CDP_HUMAN2HUMAN_URL=http://127.0.0.1:9222
LIVE_SYNC_CDP_NRG_BI_URL=http://127.0.0.1:9222
LIVE_SYNC_CDP_UYSOT_URL=http://127.0.0.1:9223
