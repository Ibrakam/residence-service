[Unit]
Description=Residence catalog sync for %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=residence-catalog-sync
Group=residence-catalog-sync
WorkingDirectory=/var/www/residence-service/current/backend
EnvironmentFile=/etc/residence-catalog-sync/runtime.env
ExecStart=/usr/local/bin/residence-catalog-sync -config /etc/residence-catalog-sync/config.json -provider %i
UMask=0077
TimeoutStartSec=70min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/residence-catalog-sync
ReadWritePaths=-/var/lib/residence-live-sync/captures
ReadOnlyPaths=-/opt/residence-live-sync
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=1024
