#!/bin/sh
set -eu
umask 077
: "${CATALOG_OUTPUT_DIR:?CATALOG_OUTPUT_DIR is required}"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CAPTURE_DIR=${LIVE_SYNC_CAPTURE_DIR:-/var/lib/residence-live-sync/captures}
exec node "$SCRIPT_DIR/src/cli.mjs" collect --provider mbc --capture-output "$CAPTURE_DIR" --catalog-output "$CATALOG_OUTPUT_DIR"
