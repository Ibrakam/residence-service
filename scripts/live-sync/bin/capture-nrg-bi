#!/bin/sh
set -eu
umask 077
: "${CATALOG_OUTPUT_DIR:?CATALOG_OUTPUT_DIR is required}"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CAPTURE_DIR=${LIVE_SYNC_CAPTURE_DIR:-/var/lib/residence-live-sync/captures}
mkdir -p "$CAPTURE_DIR"
LOCK_FILE=$CAPTURE_DIR/.nrg-capture.lock
exec flock --exclusive --timeout 600 "$LOCK_FILE" node "$SCRIPT_DIR/src/cli.mjs" collect --provider nrg-bi --capture-output "$CAPTURE_DIR" --catalog-output "$CATALOG_OUTPUT_DIR" "$@"
