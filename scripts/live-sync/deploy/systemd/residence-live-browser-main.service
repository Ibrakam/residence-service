[Unit]
Description=Residence live catalogue browser for Kayan
Requires=residence-live-display.service
Wants=residence-live-openbox.service network-online.target
After=residence-live-display.service residence-live-openbox.service network-online.target

[Service]
Type=simple
User=residence-crm-browser
Group=residence-crm-browser
Environment=DISPLAY=:99
Environment=HOME=/home/residence-crm-browser
Environment=LANG=C.UTF-8
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/google-chrome-stable --user-data-dir=/home/residence-crm-browser/crm-profile --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --remote-allow-origins=http://127.0.0.1:9222,http://localhost:9222 --no-first-run --no-default-browser-check --disable-sync --disable-save-password-bubble --disable-session-crashed-bubble --disable-features=PasswordManagerOnboarding,PasswordLeakDetection --password-store=basic --lang=ru-RU --window-size=1440,900 --start-maximized https://agent.kayan.uz/
Restart=always
RestartSec=10s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
LimitNOFILE=65535
MemoryMax=3G
TasksMax=1024

[Install]
WantedBy=multi-user.target
