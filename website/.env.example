# Optional browser-visible base for read-only live catalogue GET requests.
# Lead forms never use this value; they always post to same-origin /v1/leads.
NEXT_PUBLIC_CATALOG_API_URL=

# Canonical public origin used by metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://form.tencorp.uz

# Public mount point. This exact leading-slash value is required at both build
# and runtime when the site is served at https://form.tencorp.uz/tencrop.
NEXT_PUBLIC_APP_BASE_PATH=/tencrop

# Browser forms always post to the same-origin /v1/leads proxy. Configure its
# server-only destination here: LEAD_BACKEND_URL is the complete endpoint;
# CATALOG_API_URL is a base to which /v1/leads is appended.
# Production fails closed when neither value is configured.
LEAD_BACKEND_URL=
# CATALOG_API_URL=http://127.0.0.1:8080
CATALOG_API_URL=

# Project-specific server routes use this only when explicitly configured.
LEAD_FORWARD_URL=
