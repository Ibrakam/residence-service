# SUN raw captures contain server-only CRM provenance and signed source URLs.
# The sanitized runtime artefacts live in /data/sun-client.json and /public/sun.
/source/sun/
/tmp/pdfs/sun-*/

# local research captures and temporary extraction artifacts
/source/
/tmp/

# Build-only official API captures and provenance maps. Keep these locally for
# deterministic rebuilds, but publish only the normalized runtime catalogues.
/data/*-raw.json
/data/*-sources.json
